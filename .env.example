# Copy to `.env` and adjust. Values loaded by cmd/api and cmd/ingestor at startup.

# -----------------------------------------------------------------------------
# HTTP API (cmd/api)
# -----------------------------------------------------------------------------
LISTEN_ADDR=:8080

# -----------------------------------------------------------------------------
# ClickHouse (cmd/migrate-clickhouse and future ingest/API)
# -----------------------------------------------------------------------------
# Native protocol port is 9000. HTTP is 8123.
# CLICKHOUSE_HOST=localhost
# CLICKHOUSE_PORT=9000
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=
# Where golang-migrate stores schema_migrations (keep default unless you know why).
# CLICKHOUSE_MIGRATIONS_DATABASE=default

# -----------------------------------------------------------------------------
# Future: ingestion & Postgres metadata
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=
# DATABASE_URL=postgres://user:pass@localhost:5432/github_intel?sslmode=disable
